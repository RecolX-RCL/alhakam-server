prisma
// Prisma schema for Aluminum Workshop Manager
// Customer invoicing + payments system with multi-currency (USD / SYP)
//
// Supabase connection setup:
//  - DATABASE_URL  → transaction-mode pooler (port 6543) — for runtime queries
//  - DIRECT_URL    → session-mode pooler (port 5432) — for migrations / db push
//
// Both URLs come from Supabase → Database → Connect → ORMs → Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  id         String    @id @default(cuid())
  name       String
  phone      String?
  notes      String?
  accessCode String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  charges   Charge[]
  payments  Payment[]
}

model Charge {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  currency    String
  status      String   @default("in_progress")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments Payment[]
}

model Payment {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String
  status      String    @default("pending")
  note        String?
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  chargeId    String?
  charge       Charge?  @relation(fields: [chargeId], references: [id], onDelete: SetNull)
}
